<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BOOX Cover Sync"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="選擇 EPUB，預覽封面後同步到休眠與關機畫面。自動同步只在偵測到新書時工作。"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="自動同步"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="偵測 NeoReader 開啟新書時才同步一次，平常不輪詢以節省電量。"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/auto_sync_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="啟用自動同步" />

        <TextView
            android:id="@+id/auto_sync_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="自動同步狀態：檢查中…"
            android:textSize="13sp" />

        <Button
            android:id="@+id/accessibility_settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開啟 Accessibility 設定" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="必要權限：Accessibility、Usage Access、DUMP。DUMP 請用 ADB 一次授予；App 不會自行授予。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/open_epub_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="選擇 EPUB" />

        <TextView
            android:id="@+id/selected_file_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="尚未選擇檔案"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/cover_preview"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:background="#EEEEEE"
            android:contentDescription="封面預覽"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/book_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="封面：尚未解析（不顯示書籍資訊）"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sleep_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="同步休眠畫面（type=16）" />

        <Switch
            android:id="@+id/shutdown_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="同步關機畫面（type=17）" />

        <Button
            android:id="@+id/sync_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="立即重新同步" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="狀態：等待選擇 EPUB"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/storage_permission_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="公共儲存空間權限：檢查中…"
            android:textSize="13sp" />

        <Button
            android:id="@+id/storage_permission_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開啟公共儲存空間設定"
            android:visibility="gone" />

        <TextView
            android:id="@+id/library_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="書庫權限：使用 Android 檔案選擇器授權"
            android:textSize="13sp" />

        <Button
            android:id="@+id/usage_access_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開啟 Usage Access 設定" />

        <TextView
            android:id="@+id/background_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="背景執行：請在 BOOX 設定中允許本 App 執行"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
